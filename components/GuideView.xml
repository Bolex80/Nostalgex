<?xml version="1.0" encoding="utf-8"?>
<!-- The guide, laid out after the Nostalgex Apple TV app (TunerView,
     InfoPanelView, ChannelGuideView): the focused channel's airing top left,
     the live preview top right, the two-hour grid below. The panel comes
     after the video so that RETRO MODE's 4:3 crop can run under it. Measurements are the
     tvOS app's, which draws 1:1 on a 1920x1080 screen. -->
<component name="GuideView" extends="Group">
  <interface>
    <field id="guide" type="assocarray" onChange="onGuide" />
    <!-- For MainScene: "rebuild" after package changes, or "signOut". -->
    <field id="action" type="string" alwaysNotify="true" />
    <!-- A deep link from MainScene ({ contentId, mediaType }): tune that
         channel fullscreen. -->
    <field id="deepLink" type="assocarray" alwaysNotify="true" onChange="onDeepLink" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util/Values.brs" />
  <script type="text/brightscript" uri="pkg:/source/guide/GuideNav.brs" />
  <script type="text/brightscript" uri="pkg:/source/guide/DeepLink.brs" />
  <script type="text/brightscript" uri="pkg:/source/guide/RetroMode.brs" />
  <script type="text/brightscript" uri="pkg:/source/guide/SeasonalPrompt.brs" />
  <script type="text/brightscript" uri="pkg:/source/plex/PlexApi.brs" />
  <script type="text/brightscript" uri="pkg:/source/plex/PlexPlayback.brs" />
  <script type="text/brightscript" uri="pkg:/source/subtitles/SubtitleSelection.brs" />
  <script type="text/brightscript" uri="pkg:/source/subtitles/SubtitleSettings.brs" />
  <script type="text/brightscript" uri="pkg:/components/GuideView.brs" />
  <children>
    <Rectangle id="screen" width="1920" height="1080" color="0x000000FF" />
    <Rectangle id="videoBg" translation="[1180,0]" width="740" height="555" color="0x05050DFF" />
    <Video id="video" translation="[1180,0]" width="740" height="555" />
    <!-- RETRO MODE's CRT overlay (CRTOverlayView): scanlines, the tracking
         glitch, vignette and edge. Images from scripts/look-images.py. -->
    <Group id="crt" translation="[1180,0]">
      <Poster id="scanlines" uri="pkg:/images/look/scanlines.png" width="740" height="555" />
      <Poster id="glitch" uri="pkg:/images/look/glitch.png" width="740" height="42" visible="false" />
      <Poster id="vignette" uri="pkg:/images/look/vignette.png" width="740" height="555" />
    </Group>
    <Animation id="glitchAnim" repeat="false" easeFunction="linear">
      <Vector2DFieldInterpolator id="glitchMove" key="[0.0, 1.0]" fieldToInterp="glitch.translation" />
    </Animation>
    <Group id="haze" visible="false" opacity="0">
      <Rectangle id="hazeBg" translation="[1180,0]" width="740" height="555" color="0x000000FF" />
      <Poster id="snow" uri="pkg:/images/look/snow_0.png" translation="[1180,0]" width="740" height="556" opacity="0.32" />
      <Label id="hazeText" translation="[1180,261]" width="740" horizAlign="center" />
    </Group>
    <Animation id="hazeIn" duration="0.35" repeat="false" easeFunction="linear">
      <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="haze.opacity" />
    </Animation>
    <Animation id="snowSettle" duration="0.7" repeat="false" easeFunction="inOutQuad">
      <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[0.32, 0.14]" fieldToInterp="snow.opacity" />
    </Animation>
    <Group id="panel">
      <Rectangle width="1180" height="555" color="0x0B0B1CFF" />
      <Label id="logo" text="NOSTALGEX" translation="[40,52]" />
      <!-- TunerView's nav item: Up from the top row focuses it. -->
      <Label id="navSettings" text="SETTINGS" translation="[924,64]" width="200" horizAlign="right" />
      <Group id="info" translation="[40,204]">
        <!-- Letter-spaced text is a Label per character (VT323 is monospace). -->
        <Group id="tag" />
        <Label id="title" translation="[0,56]" width="1100" wrap="true" maxLines="2" lineSpacing="2" />
        <Label id="artist" width="1100" />
        <Label id="genres" width="1100" wrap="true" maxLines="2" />
        <Label id="subtitle" width="1100" />
        <Rectangle id="rule" width="1100" height="1" />
        <Label id="summary" width="1100" wrap="true" maxLines="2" lineSpacing="4" />
        <Group id="meta">
          <Group id="badges" />
          <Rectangle id="progressTrack" height="4" color="0xFFFFFF14" />
          <Rectangle id="progressFill" height="4" />
          <Label id="clock" />
        </Group>
        <Group id="upNextLabel" />
        <Label id="upNext" width="1000" />
      </Group>
    </Group>
    <Group id="grid" translation="[0,555]">
      <Rectangle width="1920" height="525" color="0x0D0D1FFF" />
      <Rectangle width="1920" height="60" color="0x0A0A14FF" />
      <Label id="channelHead" text="CHANNEL" translation="[12,18]" />
      <Group id="slots" />
      <Rectangle translation="[0,60]" width="1920" height="1" color="0xFFFFFF40" />
      <Group id="rows" translation="[0,61]" clippingRect="[0,0,1920,464]" />
      <Rectangle id="nowLine" width="2" height="525" color="0x00D4FFFF" />
    </Group>
    <Group id="sidebar" translation="[0,555]" visible="false" />
    <!-- Full screen's channel OSD (PlayerView ChannelOSD), bottom left. -->
    <Group id="osd" visible="false" />
    <!-- The seasonal invite's question (ChannelGuideView's confirmationDialog). -->
    <Group id="prompt" visible="false" />
    <Label id="ccToast" visible="false" translation="[1460,60]" width="400" horizAlign="right" />
    <Label id="notice" translation="[1200,500]" width="700" wrap="true" color="0xFF6B6BFF" />
  </children>
</component>
