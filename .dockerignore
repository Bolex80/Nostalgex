# Allowlist: the self-host build needs the two tuner pages and what they load,
# nothing else: none of the marketing site (no styles.css, app.js or logo/).
# Keeps the tvOS app, .env files and local data out of the context.
*
!package.json
!package-lock.json
!vite.config.js
!web-tuner.html
!plex-tuner.html
# The tuner's own styles, script and logo copies. Nothing of the marketing site.
!tuner/
# public/*.json are symlinks to these three at the root.
!channels.json
!channels-memberships.json
!franchises.json
!public/
public/*
!public/channels.json
!public/channels-memberships.json
!public/franchises.json
!scripts/
!docker/
scripts/devtools/
scripts/.lineup-tmp.html
**/.env*
**/*.secret*
**/Secrets*
