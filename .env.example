# Copy to .env (git-ignored): your TVs' addresses, space separated, and the
# developer password you set when enabling developer mode.
ROKU_HOSTS="192.0.2.10 192.0.2.11"
ROKU_DEV_PASSWORD=

# Enrichment: TMDB keywords, networks and franchises plus IMDb ratings, through
# the Nostalgex relay and its shared Supabase cache. Off unless set to on; it
# needs the relay to accept the Roku and the Supabase project the maintainer
# gives for Roku builds.
NOSTALGEX_ENRICHMENT=off
NOSTALGEX_SUPABASE_URL=
NOSTALGEX_SUPABASE_ANON_KEY=
