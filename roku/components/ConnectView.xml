<?xml version="1.0" encoding="utf-8"?>
<!-- CONNECT YOUR SERVER: the first screen when this TV isn't signed in, after
     upstream's Apple TV sign-in redesign (Views/SettingsView.swift and
     OnboardingStyle.swift). Branding on the left, the controls on the right.
     Plex: CONNECT TO PLEX, then MainScene's plex.tv/link code shown here
     (plexState, plexCode). Jellyfin and Emby are signed in here, the shortest
     way the server allows (source/mediabrowser/SignInFlow.brs);
     MediaBrowserSignInTask does the network part. -->
<component name="ConnectView" extends="Group">
  <interface>
    <!-- "plex" on each CONNECT TO PLEX; "jellyfin" or "emby" once signed in. -->
    <field id="done" type="string" alwaysNotify="true" />
    <!-- A reason shown on the first screen, such as a refused sign-in. -->
    <field id="notice" type="string" alwaysNotify="true" onChange="onNotice" />
    <!-- MainScene's Plex sign-in: "" (not showing), "connecting", "code" or
         "finding", and the plex.tv/link code. -->
    <field id="plexState" type="string" alwaysNotify="true" onChange="onPlex" />
    <field id="plexCode" type="string" onChange="onPlex" />
    <!-- Set when the viewer cancels the Plex code: MainScene stops its task. -->
    <field id="plexCancel" type="boolean" alwaysNotify="true" />
    <!-- tests/signin only: "none" or "several" stands in for the network
         search, as upstream's -uiTestDiscovery. -->
    <field id="discoveryFixture" type="string" />
    <!-- tests/signin only: a dry run. A sign-in is never asked for or saved
         (MediaBrowserSignInTask), so a TV that is signed in stays as it was. -->
    <field id="dryRun" type="boolean" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util/Values.brs" />
  <script type="text/brightscript" uri="pkg:/source/util/AppVersion.brs" />
  <script type="text/brightscript" uri="pkg:/source/util/QrCode.brs" />
  <script type="text/brightscript" uri="pkg:/source/plex/PlexApi.brs" />
  <script type="text/brightscript" uri="pkg:/source/mediabrowser/ServerKind.brs" />
  <script type="text/brightscript" uri="pkg:/source/mediabrowser/MediaBrowserApi.brs" />
  <script type="text/brightscript" uri="pkg:/source/mediabrowser/SignInFlow.brs" />
  <script type="text/brightscript" uri="pkg:/components/ConnectView.brs" />
  <children>
    <Rectangle width="1920" height="1080" color="0x000000FF" />
    <Group id="left" />
    <Group id="right" />
    <!-- Which build this is, before any sign-in exists, as upstream's
         connect screen: a support report has to be able to say. -->
    <Label id="version" translation="[100,990]" color="0xFFFFFF40" />
  </children>
</component>
